/* desk — one dark terminal world. */

Screen {
    background: #0d1117;
}

/* the always-visible compact strip */
#strip {
    dock: top;
    height: 3;
    background: #11161d;
    border: round #263041;
    padding: 0 1;
}
.tile {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    color: #c9d4e0;
}
#tile-focus {
    content-align: center middle;
}
#clock {
    width: auto;
    color: #6b7787;
    content-align: right middle;
}
.active-tile {
    background: #1b2735;
    text-style: bold;
}

/* the expandable stage */
#stage {
    padding: 1 2;
    height: 1fr;
}
#stage.hidden {
    display: none;
}

/* the key legend (replaces Textual's Footer, which truncated silently) */
#hints {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #11161d;
    color: #6b7787;
}

/* the audio picker modal (transcribe an existing file) — mirrors taskboard's
   working modal pattern: a VerticalScroll box with align on the box itself. */
AudioPicker {
    align: center middle;
    background: #0d1117 70%;
}
.pick {
    width: 62;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #0d1219;
    border: round #2dd4bf;
}
#pick-box {
    align: center middle;
}
#pick-body, #url-note {
    height: auto;
    margin-top: 1;
}
UrlPrompt {
    align: center middle;
    background: #0d1117 70%;
}
.pick Input {
    border: tall #1b2431;
    background: #0b111a;
}
.pick Input:focus {
    border: tall #2dd4bf;
}

Input {
    border: tall #1b2431;
    background: #0b111a;
    margin-top: 1;
}
Input:focus {
    border: tall #2dd4bf;
}
