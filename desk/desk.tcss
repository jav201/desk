/* desk — one dark terminal world. */

Screen {
    background: #0d1117;
}

/* the always-visible compact strip */
#strip {
    dock: top;
    height: 3;
    background: #11161d;
    border: round #263041;
    padding: 0 1;
}
.tile {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    color: #c9d4e0;
}
#tile-focus {
    content-align: center middle;
}
#clock {
    width: auto;
    color: #6b7787;
    content-align: right middle;
}
.active-tile {
    background: #1b2735;
    text-style: bold;
}

/* the expandable stage */
#stage {
    padding: 1 2;
    height: 1fr;
}
#stage.hidden {
    display: none;
}

Input {
    border: tall #1b2431;
    background: #0b111a;
    margin-top: 1;
}
Input:focus {
    border: tall #2dd4bf;
}
