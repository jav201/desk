/* desk — one dark terminal world. */

Screen {
    background: #0d1117;
}

/* the ribbon — one of the two chrome rows `deck.CHROME` accounts for */
#ribbon {
    dock: top;
    height: 1;
    background: #11161d;
}
#ribbon-cards {
    width: 1fr;
    color: #6b7787;
}
#clock {
    width: auto;
    color: #6b7787;
    content-align: right middle;
}

/* THE DECK. Every card's size and position comes from `app.seats`, which reads
   `desk/deck.py`. Nothing here may state a card width, height or offset: a
   stylesheet that also had an opinion would make the geometry seat advisory,
   and every test that asserts a card's region against it vacuous. */
#strip {
    height: 1fr;
}
.tile {
    position: absolute;
    color: #c9d4e0;
    /* a line wider than the card must be CUT, not wrapped: a wrapped line
       pushes the fields below it out of a card whose height is fixed, so the
       card would silently lose its last row to an over-long task title. */
    text-wrap: nowrap;
    overflow: hidden;
}
.active-tile {
    background: #1b2735;
}

/* the expandable stage */
#stage {
    padding: 1 2;
    height: 1fr;
}
#stage.hidden {
    display: none;
}

/* the key legend (replaces Textual's Footer, which truncated silently) */
#hints {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #11161d;
    color: #6b7787;
}

/* the audio picker modal (transcribe an existing file) — mirrors taskboard's
   working modal pattern: a VerticalScroll box with align on the box itself. */
AudioPicker {
    align: center middle;
    background: #0d1117 70%;
}
.pick {
    width: 62;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #0d1219;
    border: round #2dd4bf;
}
#pick-box {
    align: center middle;
}
#pick-body, #url-note {
    height: auto;
    margin-top: 1;
}
UrlPrompt {
    align: center middle;
    background: #0d1117 70%;
}
.pick Input {
    border: tall #1b2431;
    background: #0b111a;
}
.pick Input:focus {
    border: tall #2dd4bf;
}

Input {
    border: tall #1b2431;
    background: #0b111a;
    margin-top: 1;
}
Input:focus {
    border: tall #2dd4bf;
}
